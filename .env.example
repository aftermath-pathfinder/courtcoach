# CourtCoach — Environment Variables
# Copy this to .env and fill in values. Never commit .env to git.

# HuggingFace
HF_API_TOKEN=your_huggingface_token_here

# Backend config
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=30
MEDIAPIPE_MODEL_COMPLEXITY=1   # 0=lite, 1=full, 2=heavy — use 1 for balance

# Frontend (Vite reads these — must be prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:8000
